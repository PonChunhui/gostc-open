{
  "name": "@local/dsh-gostc",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "description": "Gostc intranet-penetration client manager for the DeepSeek Harness web client.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./shared": "./shared.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "shared.js",
    "process.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
